  {
   "id": "c-missing-source",
   "split": "challenge",
   "expected_state": "completed_or_waiting",
   "checks": [
    {
     "kind": "absent_glob",
     "pattern": "**/summary.md"
    },
    {
     "kind": "no_unknown_tool"
    },
    {
     "kind": "reply_matches",
     "pattern": "(?:缺失|不存在|未找到|找不到|无法找到|没有找到|未提供|请.*(?:提供|上传)|(?:missing|not found|cannot find|could not find|upload|provide))"
    }
