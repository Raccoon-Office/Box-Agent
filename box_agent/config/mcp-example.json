{
    "mcpServers": {
        "box-agent-web-extract": {
            "description": "Box-Agent Web Extract MCP - direct HTTP page extraction with configured-model summarization",
            "command": "box-agent-web-extract-mcp",
            "alwaysLoad": true,
            "disabled": true
        },
        "mcp-server-askecho-search-infinity": {
            "description": "Office Raccoon hosted web search",
            "url": "https://xiaohuanxiong.com/api/web/mcp/web_search/v1/mcp",
            "type": "streamable_http",
            "alwaysLoad": true,
            "disabled": true
        },
        "tavily": {
            "description": "Tavily - Web search and content extraction",
            "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=YOUR_API_KEY",
            "type": "streamable_http",
            "disabled": true
        },
        "memory": {
            "description": "Memory - Knowledge graph memory system (long-term memory based on graph database)",
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "disabled": true
        },
        "playwright": {
            "description": "Playwright - Browser automation (Chromium). Run `box-agent install-browser` first.",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest",
                "--timeout-navigation",
                "30000"
            ],
            "disabled": true,
            "connect_timeout": 15.0,
            "execute_timeout": 45.0
        }
    }
}
