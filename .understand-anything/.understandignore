# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Lines below are suggestions — uncomment to activate.
# Use ! prefix to force-include something excluded by defaults.
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.
#
# --- Active exclusions (Box-Agent scope) ---

# Skill bundles are excluded by default. The controlled PPTX compiler is a
# deliberate exception because its DeckDocument, theme/composition resolver,
# layout registry, HTML runtime, and architecture docs form one product
# subsystem that should remain navigable in the shared graph.
box_agent/skills/*
!box_agent/skills/document-skills/
box_agent/skills/document-skills/*
!box_agent/skills/document-skills/pptx/

# Keep generated/vendored PPTX runtime payloads out of the graph.
box_agent/skills/document-skills/pptx/runtime/vendor/
box_agent/skills/document-skills/pptx/scripts/dom-to-pptx.bundle.js

# Build/graphify/output artifacts and virtualenvs not covered by built-in defaults
graphify-out/
workspace/
output/
general_review/runtime/
.playwright-cli/
.venv-x64/
.build-python-x64/
.uv-cache/
.venv
.omx/
.understand-anything/

# Generated / vendored
*.egg-info/
*.so

